{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeMotionSpec",
  "description": "Specification schema for Code Motion Director animation sequences",
  "type": "object",
  "required": ["title", "language", "code"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Title displayed on the window title bar"
    },
    "language": {
      "type": "string",
      "enum": ["javascript", "typescript", "python", "rust", "go", "sql", "bash", "html", "css", "json"],
      "default": "typescript"
    },
    "aspectRatio": {
      "type": "string",
      "enum": ["9:16", "16:9", "1:1"],
      "default": "9:16"
    },
    "theme": {
      "type": "string",
      "enum": ["obsidian", "onedark", "monokai", "cyberpunk"],
      "default": "obsidian"
    },
    "code": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Lines of source code to animate"
    },
    "focusLines": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "description": "1-based line numbers to highlight while dimming other lines"
    },
    "typingSpeed": {
      "type": "number",
      "default": 35,
      "description": "Millisecond delay per typed character"
    },
    "callouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line", "label"],
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "maxLength": 30 },
          "note": { "type": "string", "maxLength": 50 },
          "side": { "type": "string", "enum": ["left", "right"], "default": "right" }
        }
      }
    },
    "terminal": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "title": { "type": "string", "default": "Terminal" },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sound": {
      "type": "object",
      "properties": {
        "typewriterClicks": { "type": "boolean", "default": true },
        "completionChime": { "type": "boolean", "default": true }
      }
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 1.0,
      "default": 8.0
    }
  }
}